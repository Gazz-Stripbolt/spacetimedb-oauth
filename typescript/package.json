{
  "name": "@pogly/spacetimedb-oauth",
  "version": "0.1.1",
  "description": "OAuth account linking and a token vault for SpacetimeDB, as a submodule: authorization code + PKCE, private tokens, scheduled refresh. Same schema and clients as oauth.rs / OAuth.cs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "spacetimedb",
    "submodule",
    "oauth",
    "pkce",
    "token-vault"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gazz-Stripbolt/spacetimedb-oauth.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/Gazz-Stripbolt/spacetimedb-oauth/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/Gazz-Stripbolt/spacetimedb-oauth/issues"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "spacetimedb": "2.11.*"
  },
  "devDependencies": {
    "spacetimedb": "2.11.*",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
