{
  "name": "@pogly/spacetimedb-oauth-client",
  "version": "0.1.0",
  "description": "Browser helpers for spacetimedb-oauth: link a third-party account by popup or redirect and finish it on your own SpacetimeDB connection.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "spacetimedb",
    "oauth",
    "pkce",
    "account-linking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gazz-Stripbolt/spacetimedb-oauth.git",
    "directory": "client"
  },
  "homepage": "https://github.com/Gazz-Stripbolt/spacetimedb-oauth/tree/main/client#readme",
  "bugs": {
    "url": "https://github.com/Gazz-Stripbolt/spacetimedb-oauth/issues"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
